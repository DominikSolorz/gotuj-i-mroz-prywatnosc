<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keep game progress out of cloud backups and device transfers. -->
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
